---
import ZigZag from './ZigZag.astro'

interface Props {
  title: string
  accent?: string
  subtitle?: string
  align?: 'left' | 'center'
}
const { title, accent, subtitle, align = 'center' } = Astro.props
---

<div class={align === 'center' ? 'mx-auto max-w-2xl text-center' : ''}>
  <ZigZag class={`h-4 w-20 text-primary ${align === 'center' ? 'mx-auto' : ''}`} />
  <h2 class="mt-3 text-3xl font-bold text-secondary md:text-4xl">
    {title} {accent && <span class="text-accent">{accent}</span>}
  </h2>
  {subtitle && <p class="mt-4 text-ink/80">{subtitle}</p>}
</div>
