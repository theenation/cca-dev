---
import Icon from './Icon.astro'
import SmartImage from './SmartImage.astro'
import { mediaUrl } from '../lib/cms'

interface Props {
  course: {
    slug: string
    title: string
    summary?: string
    thumbnail?: unknown
    rating?: number
    students?: string
    category?: string
  }
  loading?: 'lazy' | 'eager'
}
const { course, loading } = Astro.props
const img = mediaUrl(course.thumbnail as never, '/images/f-image1.png')
const categoryLabel: Record<string, string> = {
  undergraduate: 'Undergraduate Courses',
  diploma: 'Diploma Courses',
  graduate: 'Graduate Courses',
}
---

<div class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-sm transition-shadow hover:shadow-xl">
  <div class="relative h-48 overflow-hidden">
    <SmartImage src={img} alt={course.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading={loading} />
    {course.category && (
      <span class="absolute bottom-3 left-3 rounded-md bg-secondary/90 px-3 py-1 text-xs font-semibold text-white">
        {categoryLabel[course.category] || course.category}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold text-secondary">{course.title}</h3>
    {course.rating && (
      <div class="mt-1 flex items-center gap-1 text-xs text-muted">
        <span>({course.rating} ratings)</span>
        <span class="flex text-amber-400">
          {Array.from({ length: 5 }).map((_, i) => (
            <Icon name="star" class={`h-3.5 w-3.5 ${i < Math.round(course.rating || 0) ? 'fill-amber-400' : 'fill-none opacity-30'}`} />
          ))}
        </span>
      </div>
    )}
    {course.summary && <p class="mt-3 flex-1 text-sm text-ink/80">{course.summary}</p>}
    <div class="mt-5 flex items-center justify-between border-t border-line pt-4 text-sm">
      {course.students && (
        <span class="flex items-center gap-2 text-muted"><Icon name="users" class="h-4 w-4" /> {course.students}</span>
      )}
      <a href={`/we-offer/${course.slug}`} class="flex items-center gap-1 font-semibold text-primary hover:text-accent">
        ENROLL COURSE <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </div>
</div>
