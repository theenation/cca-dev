---
interface Props {
  eyebrow: string
  title: string
  subtitle?: string
  align?: 'left' | 'center'
}
const { eyebrow, title, subtitle, align = 'left' } = Astro.props
---

<div class={align === 'center' ? 'text-center' : ''}>
  <p class="text-sm font-bold tracking-wider text-accent uppercase">{eyebrow}</p>
  <h2 class="mt-2 text-3xl font-extrabold text-secondary md:text-4xl">{title}</h2>
  {subtitle && <p class={`mt-4 text-ink/80 ${align === 'center' ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}>{subtitle}</p>}
</div>
