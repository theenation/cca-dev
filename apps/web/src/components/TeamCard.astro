---
import Icon from './Icon.astro'
import SmartImage from './SmartImage.astro'
import { mediaUrl } from '../lib/cms'

interface Props {
  member: {
    name: string
    role: string
    image?: unknown
    socials?: { platform: string; url: string }[]
  }
  loading?: 'lazy' | 'eager'
}
const { member, loading } = Astro.props
const img = mediaUrl(member.image as never, '/images/team/govinda-raj-panta.webp')
---

<div class="text-center">
  <div class="mx-auto h-56 w-56 overflow-hidden rounded-full border-4 border-cloud">
    <SmartImage src={img} alt={member.name} class="h-full w-full object-cover" loading={loading} />
  </div>
  <h3 class="mt-5 text-lg font-bold text-secondary">{member.name}</h3>
  <p class="text-primary">{member.role}</p>
  {member.socials && member.socials.length > 0 && (
    <div class="mt-3 flex justify-center gap-2">
      {member.socials.map((s) => (
        <a href={s.url} class="grid h-9 w-9 place-items-center rounded-full bg-secondary text-white hover:bg-accent" aria-label={s.platform}>
          <Icon name={s.platform} class="h-4 w-4" />
        </a>
      ))}
    </div>
  )}
</div>
