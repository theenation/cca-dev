---
import Icon from './Icon.astro'

interface Props {
  testimonial: {
    name: string
    role?: string
    rating?: number
    message: string
  }
}
const { testimonial } = Astro.props
---

<div class="flex h-full flex-col rounded-2xl bg-cloud p-8 text-center shadow-sm">
  <h4 class="text-lg font-bold text-secondary">{testimonial.name}</h4>
  <p class="text-sm text-muted">{testimonial.role || 'Student'}</p>
  <div class="mx-auto mt-2 flex text-amber-400">
    {Array.from({ length: 5 }).map((_, i) => (
      <Icon name="star" class={`h-4 w-4 ${i < (testimonial.rating || 5) ? 'fill-amber-400' : 'fill-none opacity-30'}`} />
    ))}
  </div>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-ink/80">{testimonial.message}</p>
</div>
