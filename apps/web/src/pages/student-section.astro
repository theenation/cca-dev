---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import SectionHeading from '../components/SectionHeading.astro'
import SmartImage from '../components/SmartImage.astro'
import { getStudentSectionPage, mediaUrl } from '../lib/cms'

const studentSection = await getStudentSectionPage()
const cbeSubjects = studentSection.cbeSubjects
const worldRankPhotos = studentSection.worldRankPhotos ?? []
const nepalRankPhotos = studentSection.nepalRankPhotos ?? []
---

<Layout title="Student Section | CCA - Certified College of Accountancy" description={studentSection.heroSubtitle}>
  <PageHero title={studentSection.heroTitle} subtitle={studentSection.heroSubtitle} />

  <section class="mx-auto max-w-7xl px-6 py-20" id="rank-holders">
    <SectionHeading title="World Rank Holder" accent="from CCA" />
    <div class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      {worldRankPhotos.map((p, i) => (
        <SmartImage
          src={mediaUrl(p.image)}
          alt="CCA world rank holder"
          class="aspect-square w-full rounded-2xl object-cover shadow-md"
          loading={i < 4 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  </section>

  <section class="bg-cloud py-20">
    <div class="mx-auto max-w-7xl px-6">
      <SectionHeading title="Nepal Rank Holder" accent="from CCA" />
      <div class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {nepalRankPhotos.map((p) => (
          <SmartImage src={mediaUrl(p.image)} alt="CCA Nepal rank holder" class="aspect-square w-full rounded-2xl object-cover shadow-md" />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20" id="cbe-rank">
    <SectionHeading title="CBE Excellent" accent="Performance" />
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {cbeSubjects.map((s) => (
        <div class="rounded-2xl border border-line p-8 text-center shadow-sm">
          {s.icon && <SmartImage src={mediaUrl(s.icon)} alt={s.name} class="mx-auto h-20 w-20 object-contain" />}
          <h3 class="mt-4 text-lg font-bold text-secondary">{s.name}</h3>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cloud py-20">
    <div class="mx-auto max-w-7xl px-6">
      <SectionHeading title="CCA Scholarship" accent="Holders" />
      {studentSection.scholarshipText && <p class="mx-auto mt-6 max-w-2xl text-center text-ink/80">{studentSection.scholarshipText}</p>}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20">
    <SectionHeading title="CCA Fee" accent="Structure" />
    {studentSection.feeStructureText && <p class="mx-auto mt-6 max-w-2xl text-center text-ink/80">{studentSection.feeStructureText}</p>}
    <div class="mt-8 text-center">
      <a href={studentSection.feeStructureUrl} class="btn-primary">Download Fee Structure</a>
    </div>
  </section>

  <section class="bg-cloud py-20">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <SectionHeading title="CCA" accent="Brochure" />
      <a href={studentSection.brochureUrl} class="btn-accent mt-8 inline-flex">Download Brochure</a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20" id="complain">
    <SectionHeading title="Student Complain" accent="Section" />
    <form id="complaint-form" class="mt-10 space-y-4 rounded-2xl border border-line p-8 shadow-sm">
      <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
      <input type="text" name="name" required placeholder="Full Name" class="w-full rounded-md border border-line px-4 py-3 text-sm" />
      <input type="text" name="studentId" placeholder="Student ID" class="w-full rounded-md border border-line px-4 py-3 text-sm" />
      <textarea name="message" required placeholder="Describe your complaint" rows={5} class="w-full rounded-md border border-line px-4 py-3 text-sm"></textarea>
      <button type="submit" class="btn-primary">Submit Complaint</button>
      <p data-form-status></p>
    </form>
    <script>
      import { initEnquiryForm } from '../lib/forms.client'
      const form = document.getElementById('complaint-form')
      if (form instanceof HTMLFormElement) initEnquiryForm(form, 'complaint')
    </script>
  </section>
</Layout>
