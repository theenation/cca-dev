---
import Layout from '../../layouts/Layout.astro'
import Icon from '../../components/Icon.astro'
import CourseCard from '../../components/CourseCard.astro'
import CourseHeading from '../../components/CourseHeading.astro'
import SmartImage from '../../components/SmartImage.astro'
import { getCourses, mediaUrl } from '../../lib/cms'
import { renderContent } from '../../lib/content'

export async function getStaticPaths() {
  const courses = await getCourses()
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course, allCourses: courses } }))
}

const { course, allCourses } = Astro.props as {
  course: Awaited<ReturnType<typeof getCourses>>[number]
  allCourses: Awaited<ReturnType<typeof getCourses>>
}

const heroImg = mediaUrl(course.heroImage, '/images/hero-bg.webp')
const contentHtml = renderContent(course.content)
const otherCourses = allCourses.filter((c) => c.slug !== course.slug).slice(0, 5)

const infoStrip = [
  { icon: 'award', label: 'Awarding Body', value: course.awardingBody },
  { icon: 'layers', label: 'Level', value: course.levels },
  { icon: 'clock', label: 'Duration', value: course.duration },
  { icon: 'calendar', label: 'Intake', value: course.intake },
].filter((item) => item.value)

const highlights = course.highlights || []
const benefits = course.benefits || []
const curriculum = course.curriculum || []
const careerOpportunities = course.careerOpportunities || []
const entryRequirements = course.entryRequirements || []
const faculty = course.faculty
---

<Layout title={`${course.title} | CCA - Certified College of Accountancy`} description={course.summary}>
  <section class="relative overflow-hidden bg-secondary pt-24 pb-20 text-white">
    <SmartImage src={heroImg} alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-br from-primary/90 to-secondary/90"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center">
      <h1 class="text-4xl font-extrabold text-white md:text-5xl">{course.title}</h1>
      {course.summary && <p class="mt-4 text-white/85">{course.summary}</p>}
      <a href="/enroll-course" class="btn-accent mt-8">Enroll Now</a>
    </div>
  </section>

  {infoStrip.length > 0 && (
    <div class="relative z-10 mx-auto -mt-10 max-w-5xl px-6">
      <div class="grid grid-cols-2 divide-y divide-line rounded-2xl border border-line bg-white shadow-xl sm:grid-cols-4 sm:divide-x sm:divide-y-0">
        {infoStrip.map((item) => (
          <div class="flex flex-col gap-2 p-6">
            <Icon name={item.icon} class="h-5 w-5 text-primary" />
            <p class="text-xs font-bold tracking-wide text-muted uppercase">{item.label}</p>
            <p class="font-bold text-secondary">{item.value}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <section class="mx-auto max-w-4xl px-6 py-20">
    <CourseHeading eyebrow="Overview" title="About the programme" />
    <article class="prose prose-neutral mt-6 max-w-none text-ink/80" set:html={contentHtml} />
  </section>

  {highlights.length > 0 && (
    <section class="bg-primary py-14 text-white">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-6 text-center md:grid-cols-4">
        {highlights.map((item) => (
          <div class="flex flex-col items-center gap-3">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/10">
              <Icon name={item.icon} class="h-6 w-6" />
            </span>
            <p class="font-semibold">{item.label}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {benefits.length > 0 && (
    <section class="mx-auto max-w-7xl px-6 py-20">
      <CourseHeading eyebrow="Why choose this programme" title="Key benefits" />
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {benefits.map((item) => (
          <div class="rounded-2xl border border-line bg-white p-8 shadow-sm">
            <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <Icon name={item.icon} class="h-7 w-7" />
            </span>
            <h3 class="mt-6 text-lg font-bold text-secondary">{item.title}</h3>
            <p class="mt-2 text-ink/80">{item.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {curriculum.length > 0 && (
    <section class="bg-cloud py-20">
      <div class="mx-auto max-w-7xl px-6">
        <CourseHeading eyebrow="Curriculum" title="Programme papers" />
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {curriculum.map((level) => (
            <div class="overflow-hidden rounded-2xl border border-line bg-white">
              <div class="bg-primary p-5 text-white">
                <p class="font-bold">{level.levelTitle}</p>
                {level.levelSubtitle && <p class="mt-1 text-sm text-white/70">{level.levelSubtitle}</p>}
              </div>
              <div class="divide-y divide-line">
                {(level.papers || []).map((paper) => (
                  <div class="flex items-center gap-3 px-5 py-3">
                    <span class="rounded-md bg-primary/10 px-2 py-1 text-xs font-bold text-primary">{paper.code}</span>
                    <span class="text-sm text-ink">{paper.title}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {careerOpportunities.length > 0 && (
    <section class="mx-auto max-w-7xl px-6 py-20">
      <CourseHeading eyebrow="Your future" title="Career opportunities" />
      <div class="mt-10 flex flex-wrap gap-4">
        {careerOpportunities.map((item) => (
          <span class="inline-flex items-center gap-3 rounded-full border border-line bg-white px-5 py-3 font-semibold text-secondary">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-accent/10 text-accent">
              <Icon name="briefcase" class="h-4 w-4" />
            </span>
            {item.title}
          </span>
        ))}
      </div>
    </section>
  )}

  {entryRequirements.length > 0 && (
    <section class="bg-cloud py-20">
      <div class="mx-auto max-w-5xl px-6">
        <CourseHeading eyebrow="Admission" title="Entry requirements" />
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {entryRequirements.map((req) => (
            <div>
              <h3 class="font-bold text-secondary">{req.title}</h3>
              <ul class="mt-3 space-y-2">
                {(req.points || []).map((point) => (
                  <li class="flex gap-2 text-ink/80">
                    <Icon name="check" class="mt-1 h-4 w-4 flex-shrink-0 text-accent" />
                    <span>{point.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {course.entryNote && <p class="mt-10 text-sm text-ink/70 italic">{course.entryNote}</p>}
      </div>
    </section>
  )}

  {faculty?.description && (
    <section class="mx-auto max-w-4xl px-6 py-20">
      <CourseHeading eyebrow="Our people" title="Faculty" />
      <p class="mt-6 text-ink/80">{faculty.description}</p>
      {faculty.quote && (
        <blockquote class="mt-6 border-l-4 border-accent pl-4 text-ink/80 italic">"{faculty.quote}"</blockquote>
      )}
      {faculty.name && (
        <p class="mt-6 font-semibold text-secondary">
          {faculty.title && <span class="font-normal text-ink/70">{faculty.title}: </span>}
          {faculty.name}
        </p>
      )}
    </section>
  )}

  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-secondary py-20 text-center text-white">
    <div class="relative mx-auto max-w-2xl px-6">
      <h2 class="text-3xl font-extrabold text-white md:text-4xl">Ready for what's next?</h2>
      <p class="mt-4 text-white/85">
        Begin your {course.title} journey with CCA. Book a free counseling session with our advisors.
      </p>
      <a href="/enroll-course" class="btn-accent mt-8">Enroll Course</a>
    </div>
  </section>

  {otherCourses.length > 0 && (
    <section class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold text-secondary">Explore More Courses</h2>
      <div class="mt-10 grid gap-8 text-left md:grid-cols-3">
        {otherCourses.slice(0, 3).map((c) => <CourseCard course={c} />)}
      </div>
    </section>
  )}
</Layout>
