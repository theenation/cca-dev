# Local dev: a plain sqlite file. Leave DATABASE_AUTH_TOKEN unset.
DATABASE_URL=file:./cms.db
DATABASE_AUTH_TOKEN=

# Production: a Turso (libSQL) database URL + auth token instead, e.g.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=<token from `turso db tokens create`>

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Astro frontend origin(s) allowed to call the CMS REST API via CORS.
WEB_URL=http://localhost:4321

# Optional: only needed in production (Vercel). When set, uploads go to
# Vercel Blob instead of local disk (serverless hosts have no persistent
# filesystem). Automatically populated once Blob storage is attached to a
# Vercel project — usually no need to set this by hand.
BLOB_READ_WRITE_TOKEN=
